---
import {
  Badge,
  Badges,
  BuildOutput,
  Callout,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import catalog from '../../../examples/site/catalog.txt?raw';
import { chartletChart } from '../chartlet';
import { figure } from '../showcase';

// Written by `cargo run --example site_showcase`: one line per entry of `catalog()`.
const indicatorCount = catalog.trim().split('\n').length;
const goldenSuites = Object.keys(import.meta.glob('../../../tests/golden_reference_*.rs', { query: '?raw' })).length;
// Each contract case is one table headed `@<case>` in tests/fixtures/contract_*.txt: a complete
// expected run of one indicator, bar by bar.
const contractFixtures = import.meta.glob<string>('../../../tests/fixtures/contract_*.txt', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const contractCases = Object.values(contractFixtures)
  .map((text) => text.split('\n').filter((line) => line.startsWith('@')).length)
  .reduce((a, b) => a + b, 0);

const version = '0.31.0';
// A calm price chart of a fictitious instrument, as Kestrel draws its own with chartlet.
const hero = chartletChart('demo-chart');
const composite = figure('composite-signal', 'Composite signal chart');

const cargoToml = `[dependencies]
kestrel-chartkit = { git = "https://github.com/casoon/kestrel-chartkit.git", tag = "v${version}" }`;

const mainRs = `use kestrel_chartkit::{build_checked, Bar, Indicator};
use std::collections::HashMap;

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let params = HashMap::from([("rsi_len".to_string(), 14.0)]);
    let mut rsi = build_checked("rsi", &params)?;

    let bar = Bar::try_new(1700000000, 100.0, 105.0, 95.0, 104.0, 1000.0)?;
    if let Some(output) = rsi.on_bar(&bar) {
        println!("RSI: {:.2}", output.value);
    }
    Ok(())
}`;
---

<Base>
  <Hero
    title="Technical analysis as plain, testable Rust: indicators, regimes, signals and charts."
    lead="kestrel-chartkit turns a stream of price bars into the readings a trading tool needs: indicator values, the current market regime, a composite signal that explains itself, and static SVG charts. It is a library of mathematics, nothing more: you bring the bars, it computes."
  >
    <Install
      commands={[
        {
          label: 'cargo',
          command: `cargo add kestrel-chartkit --git https://github.com/casoon/kestrel-chartkit --tag v${version}`,
        },
      ]}
    />
    <Badges>
      <Badge tone="brand">in development</Badge>
      <Badge>v{version}</Badge>
      <Badge>BUSL-1.1</Badge>
      <Badge>Rust 1.87+</Badge>
    </Badges>
    <div slot="output" set:html={hero} />
  </Hero>

  <Callout type="caution" title="Work in progress">
    kestrel-chartkit is under active development and not yet a stable foundation. Indicator names,
    parameters, outputs and whole modules can still change fundamentally between versions, and
    there is no compatibility promise before 1.0. Pin a release tag and expect to adapt when you
    upgrade.
  </Callout>

  <Facts
    items={[
      { value: String(indicatorCount), label: 'indicators, each built by name from one definition' },
      { value: String(contractCases), label: 'contract cases: complete expected runs, bar by bar' },
      { value: String(goldenSuites), label: 'golden-reference test suites' },
      { value: '4', label: 'market regimes, from fixed and documented rules' },
    ]}
  />

  <Features
    items={[
      {
        title: 'Streaming by design',
        body: 'Every indicator implements one trait, consumes one bar at a time and answers from the bar its warmup ends. The same code serves a backtest over years of history and a live feed.',
      },
      {
        title: 'One definition per indicator',
        body: `Name, aliases, every parameter with default, accepted range and meaning, and how it is built, in one place. Configuration typos and out-of-range values are errors, not silent defaults. The <a href="${url('docs/reference/indicators/')}">indicator reference</a> is generated from these definitions.`,
      },
      {
        title: 'Checked against independent references',
        body: 'Each indicator runs against expected values derived outside the crate: a second implementation of the documented formula, exact arithmetic or a hand-built scenario. A contract fixes every bar: whether a value exists, every field it carries and every alert it raises.',
      },
      {
        title: 'Signals you can explain',
        body: 'Regime and composite score follow a handful of fixed thresholds. A direction against the regime is vetoed, and every signal carries its subscores.',
      },
      {
        title: 'Events with a known time',
        body: 'Pivots and zones carry when they formed and when they became known. Detectors for breakouts, double bottoms, divergences and more alert on the bar the event is confirmed, never earlier.',
      },
    ]}
  />

  <BuildOutput
    caption="A composite signal on synthetic bars: MACD, Vortex and Trend Quality scored per bar and weighed against the regime. Every chart on this site is an SVG written by the crate's own renderer (cargo run --example site_showcase)."
    file="examples/site/composite-signal.svg"
  >
    <Fragment set:html={composite} />
  </BuildOutput>

  <Callout type="note" title="Pure computation">
    The crate contains mathematics only: indicators, statistics, valuation formulas and renderers.
    It fetches no market data, connects to no broker or exchange, and holds no credentials, keys,
    account or personal data. A composite signal is a rule-based summary of indicator readings,
    not a forecast, and nothing here is investment advice.
  </Callout>

  <Quickstart
    lead="Add the crate from the repository, build an indicator by name and feed it bars. The full walkthrough lives in the documentation."
    steps={[
      'Add the dependency, pinned to a release tag.',
      'Build an indicator from the registry with <code>build_checked</code>.',
      'Stream validated bars through <code>on_bar</code> and read the output.',
    ]}
  >
    <CodeBlock code={cargoToml} lang="toml" title="Cargo.toml" label="Cargo.toml" />
    <CodeBlock code={mainRs} lang="rust" title="main.rs" label="Rust" />
  </Quickstart>
</Base>
