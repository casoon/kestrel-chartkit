---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Faq,
  Features,
  FlowPanel,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
  Split,
  StatBand,
  Tradeoffs,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { indicators, inlineChart, spec } from '../chartlet';

// Written by `cargo run --example site_showcase`: one entry per indicator of `catalog()`, with
// its family, so every count below follows the catalog.
const indicatorCount = indicators.length;
const perFamily = (prefix: string) => String(indicators.filter((i) => i.family.startsWith(prefix)).length);

const goldenSuites = Object.keys(import.meta.glob('../../../tests/golden_reference_*.rs', { query: '?raw' })).length;
// Each contract case is one table headed `@<case>` in tests/fixtures/contract_*.txt: a complete
// expected run of one indicator, bar by bar.
const contractFixtures = import.meta.glob<string>('../../../tests/fixtures/contract_*.txt', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const contractCases = Object.values(contractFixtures)
  .map((text) => text.split('\n').filter((line) => line.startsWith('@')).length)
  .reduce((a, b) => a + b, 0);
// The verification status is the `verification` of each catalog entry, as the example wrote it, so
// the counts below equal the catalog.
const tracked = indicators.length;
const verified = indicators.filter((i) => i.verified).length;

// The release the theme reads from Cargo.toml, so install line and badge follow every release.
const version = config.version;
// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

// A price chart of a fictitious CASOON share (invented prices): the numbers from kestrel-chartkit,
// the drawing from chartlet, both when this site is built.
const hero = inlineChart(spec('hero'), 'hero');
// The same chart laid out for phones, so its labels stay readable at 390 px.
const heroNarrow = inlineChart({ ...spec('hero'), width: 380, height: 660 }, 'hero-narrow');
const regime = inlineChart(spec('regime'), 'regime');

const mainRs = `let params = HashMap::from([("rsi_len".to_string(), 14.0)]);
let mut rsi = build_checked("rsi", &params)?;

for bar in &bars {
    if let Some(output) = rsi.on_bar(bar) {
        println!("RSI: {:.2}", output.value);
    }
}`;
---

<Base>
  <Hero
    title="Technical analysis in Rust, checked."
    lead={`${indicatorCount} streaming indicators and detectors, market regime, composite signals, trade evaluation and instrument valuation. kestrel-chartkit does the math and hands back plain data; chartlet or kestrel-loom draws it.`}
  >
    <Install
      commands={[
        {
          label: 'cargo',
          command: `cargo add kestrel-chartkit --git https://github.com/casoon/kestrel-chartkit --tag v${version}`,
        },
      ]}
    />
    <Badges>
      <Badge>v{version}</Badge>
      <Badge>pre-1.0</Badge>
      <Badge>BUSL-1.1</Badge>
      <Badge>Rust 1.87+</Badge>
    </Badges>
    <div slot="output" class="hero-chart">
      <div class="wide" set:html={hero} />
      <div class="narrow" set:html={heroNarrow} />
    </div>
    <span slot="caption">
      A fictitious share with invented prices. kestrel-chartkit computes every value when this site
      is built; the chart is drawn with <a class="inline-link" href="https://casoon.github.io/chartlet/">chartlet</a>.
    </span>
  </Hero>

  <StatBand
    items={[
      { value: String(indicatorCount), label: 'indicators and detectors in the catalog' },
      { value: `${verified}/${tracked}`, label: 'entries verified independently of the Rust code' },
      { value: String(contractCases), label: 'contract cases, each a full expected run' },
      { value: String(goldenSuites), label: 'golden-reference test suites' },
    ]}
  />

  <Features
      layout="grid"
      heading="What's in the crate"
      items={[
        {
          icon: perFamily('Oscillators'),
          title: 'Oscillators',
          body: 'RSI, Stochastic RSI, MACD, TSI, Williams %R, CCI, Fisher Transform, WaveTrend and more.',
        },
        {
          icon: perFamily('Moving averages'),
          title: 'Averages, bands and trend lines',
          body: 'SMA to KAMA, VIDYA and T3, Bollinger and Keltner, Ichimoku, Supertrend, anchored VWAP.',
        },
        {
          icon: perFamily('Volatility'),
          title: 'Volatility and trend strength',
          body: 'ATR, ADX and DMI, Aroon, Choppiness, Garman–Klass, Chande Kroll Stop, Chandelier Exit.',
        },
        {
          icon: perFamily('Volume'),
          title: 'Volume',
          body: 'OBV, VWAP, Chaikin Money Flow, Klinger, cumulative delta and several volume profiles.',
        },
        {
          icon: perFamily('Market structure'),
          title: 'Structure and patterns',
          body: 'Pivots, break of structure, order blocks, fair value gaps, liquidity sweeps, ZigZag, point and figure.',
        },
        {
          icon: perFamily('Composite'),
          title: 'Composite read-outs',
          body: 'Indicators that combine several readings into one statement, such as trend quality or compression zones.',
        },
        {
          icon: 'RGM',
          title: 'Regime and scoring',
          body: 'Four market regimes from fixed rules, a trade permission per regime, weighted scores with their subscores and a risk plan.',
        },
        {
          icon: 'EVAL',
          title: 'Evaluation and analytics',
          body: 'R-multiples, win rate, profit factor, drawdown and expectancy; correlation matrix and relative-strength ranking.',
        },
        {
          icon: 'VAL',
          title: 'Valuation and risk',
          body: 'Black–Scholes–Merton and Black-76 with Greeks, fixed-rate bonds over real coupon schedules, VaR and stress scenarios.',
        },
      ]}
    />

  <Split
    eyebrow="Drawing"
    title="Computed once, drawn where you need it"
    lead="kestrel-chartkit draws nothing itself. Every result is plain data — values, extras, alerts, zones — and overlays such as signal markers and levels can travel as a renderer-neutral `Scene`."
    points={[
      '**chartlet** renders static SVG, like every chart on this site.',
      '**kestrel-loom** draws an interactive chart in the browser: Rust to WebAssembly to Canvas, with indicator panes; alpha.',
      'Your own renderer reads the same data; with the default `serde` feature it serialises as it is.',
    ]}
    links={[
      { label: `All ${indicatorCount} indicators drawn`, href: url('showcase/') },
      { label: 'Visualising', href: url('docs/guides/visualising/') },
      { label: 'kestrel-loom on GitHub', href: 'https://github.com/casoon/kestrel-loom' },
    ]}
  >
    <FlowPanel
      start={{ title: 'kestrel-chartkit', body: 'values, alerts, zones and a Scene, per bar' }}
      paths={[
        { label: 'static', title: 'chartlet', body: 'SVG at build time' },
        { label: 'interactive', title: 'kestrel-loom', body: 'WebAssembly and Canvas in the browser' },
        { label: 'custom', title: 'your renderer', body: 'plain data, serde' },
      ]}
      result="one chart, numbers from one source"
    />
  </Split>

  <Split
    reverse
    eyebrow="Regime and signals"
    title="Signals you can trace back"
    lead="`classify_regime` sorts every bar into one of four regimes from ADX and ATR, with fixed thresholds. Scoring weighs indicator readings into a composite signal that keeps its subscores."
    points={[
      'Bullish expansion, bearish expansion, consolidation and transition — each with a trade permission: clear, caution or veto.',
      'A direction against the regime is vetoed, not averaged away.',
      'Events alert on the bar they are confirmed, never earlier.',
    ]}
    links={[
      { label: 'Market regime', href: url('docs/guides/market-regime/') },
      { label: 'Composite scoring', href: url('docs/guides/composite-scoring/') },
    ]}
  >
    <div class="figure" set:html={regime} />
  </Split>

    <Features
      heading="Checked against a second implementation"
      items={[
        {
          title: 'Independent reference',
          body: `${verified} of ${tracked} entries are verified: their expected values come from a derivation independent of the Rust code — a second implementation in Python with the standard library only, or a hand-derived scenario. Where a formula leaves a convention open, the fixture states the choice.${verified < tracked ? ' The remaining entries are marked as not yet verified.' : ''}`,
        },
        {
          title: 'Contracts, bar by bar',
          body: `${contractCases} contract cases fix a complete run per indicator: whether a value exists on each bar, every field it carries and every alert it raises, within a stated tolerance.`,
        },
        {
          title: 'Reproducible',
          body: `${goldenSuites} golden-reference suites cover indicators, structure, analytics and valuation. The reference regenerates every fixture byte for byte, so anyone with Python can check the expected values.`,
        },
      ]}
    />

  <Quickstart
    lead="Build an indicator by name and feed it bars. The quickstart runs a complete example from the terminal."
    steps={[
      'Add the dependency, pinned to a release tag.',
      'Build an indicator from the catalog with <code>build_checked</code>.',
      'Stream validated bars through <code>on_bar</code> and read the output.',
    ]}
  >
    <div class="qs">
      <CodeBlock code={mainRs} lang="rust" title="main.rs" label="Rust" />
      <Button href={url('docs/getting-started/quickstart/')} variant="secondary">Read the quickstart</Button>
    </div>
  </Quickstart>

  <Tradeoffs
    eyebrow="Status"
    title="What to expect"
    lead="kestrel-chartkit is under active development. Read this before you build on it."
    items={[
      '**Pre-1.0.** Names, parameters and outputs can still change between minor versions; pin a release tag.',
      '**Pure computation.** No market data, no broker or exchange connection, no credentials — you bring the bars.',
      '**No forecast.** A composite signal summarises indicator readings by fixed rules; it is not investment advice.',
      '**Install from the repository.** crates.io and docs.rs still carry an old version.',
    ]}
  />

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'How do I find the right indicator?',
        a: 'The showcase draws every indicator of the catalog on the same chart, with its default parameters and the Rust call that builds it. The indicator reference lists parameters, outputs and alerts.',
      },
      {
        q: 'Does kestrel-chartkit draw charts itself?',
        a: 'No. It returns plain indicator and signal data; chartlet draws static charts like the ones on this site, kestrel-loom an interactive chart in the browser (alpha).',
      },
      {
        q: 'Does it work on live data?',
        a: 'Yes. Every indicator consumes one bar at a time and answers from the bar its warmup ends, so the same code serves a backtest over years of history and a live feed.',
      },
      {
        q: 'Does the crate fetch market data or need API keys?',
        a: 'No. It contains mathematics only: it fetches no market data, connects to no broker or exchange, and holds no credentials, keys, accounts or personal data.',
      },
    ]}
  />
</Base>

<style>
  .inline-link {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .hero-chart {
    min-width: 0;
  }
  .hero-chart :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .narrow {
    display: none;
  }
  @media (max-width: 640px) {
    .wide {
      display: none;
    }
    .narrow {
      display: block;
    }
  }
  .figure {
    min-width: 0;
  }
  .figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .qs {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
  }
  .qs > :global(*:first-child) {
    align-self: stretch;
  }
</style>
