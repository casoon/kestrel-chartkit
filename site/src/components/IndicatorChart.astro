---
// The chart of one indicator on the demo series, as two lazily loaded SVG files (light and dark);
// CSS shows the one matching the page. Nothing is shown for an indicator without a chart.
import { url } from '@casoon/pages-theme/url';

interface Props {
  name: string;
}

type Spec = { description?: string; width?: number; height?: number };
const specs = import.meta.glob<Spec>('../../.generated/indicators/*.json', {
  import: 'default',
  eager: true,
});

const { name } = Astro.props;
const spec = specs[`../../.generated/indicators/${name}.json`];
const alt = spec?.description ?? '';
---

{
  spec && (
    <figure class="indicator-chart">
      <img
        class="light"
        src={url(`indicator-charts/${name}-light.svg`)}
        alt={alt}
        width={spec.width}
        height={spec.height}
        loading="lazy"
        decoding="async"
      />
      <img
        class="dark"
        src={url(`indicator-charts/${name}-dark.svg`)}
        alt={alt}
        width={spec.width}
        height={spec.height}
        loading="lazy"
        decoding="async"
      />
    </figure>
  )
}

<style>
  .indicator-chart {
    margin: 16px 0 24px;
  }
  .indicator-chart img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .indicator-chart .dark {
    display: none;
  }
  :global(:root[data-theme='dark']) .indicator-chart .light {
    display: none;
  }
  :global(:root[data-theme='dark']) .indicator-chart .dark {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .indicator-chart .light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .indicator-chart .dark {
      display: block;
    }
  }
</style>
