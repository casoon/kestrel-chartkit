      { "id": "registry", "label": "Registry", "sublabel": "catalog, build_checked, build_typed", "in": "crate" },
      { "id": "definitions", "label": "Definitions", "sublabel": "parameters, ranges, relations", "kind": "storage", "in": "crate" },
      { "id": "indicators", "label": "Indicators", "sublabel": "Indicator::on_bar, alerts", "in": "crate" },
      { "id": "regime", "label": "Regime and scoring", "sublabel": "classify_regime, aggregate_subscores", "in": "crate" },
      { "id": "structure", "label": "Structure and analytics", "sublabel": "pivots, zones, read-outs, evaluation", "in": "crate" },
      { "id": "renderer", "label": "Renderer", "sublabel": "chartlet, kestrel-loom", "kind": "external" }
    ],
    "boundaries": [{ "id": "crate", "label": "kestrel-chartkit (pure computation)" }],
    "connections": [
      { "from": "app", "to": "registry", "label": "name and parameters" },
